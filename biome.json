{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
    "ignore": ["node_modules", "dist", "coverage", "coverage-vitest", "reports"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useConst": "warn"
      },
      "suspicious": {
        "noDoubleEquals": "warn"
      }
    }
  },
  "formatter": {
    "enabled": false
  }
}
